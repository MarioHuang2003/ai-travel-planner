# ============================================================
# 复制本文件为 .env.local，并填入你自己的 Key
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# 兼容 OpenAI 协议的大模型服务端点
#   https://open.bigmodel.cn/api/paas/v4/chat/completions
# 也可换成：
#   DeepSeek      https://api.deepseek.com/chat/completions
#   月之暗面 Kimi  https://api.moonshot.cn/v1/chat/completions
#   OpenAI        https://api.openai.com/v1/chat/completions
VITE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 你的 API Key
#   智谱：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
#   DeepSeek：https://platform.deepseek.com/api_keys
VITE_LLM_API_KEY=your_api_key_here

# 模型名称（按推荐度排序）
#   智谱 glm-5.1        ⭐ 推荐：内置「联网搜索 + 深度思考」，地址/票价更精准、
#                          游玩时长更合理。需要充值，单次行程约 ¥0.05~0.20
#   智谱 glm-4-flash    免费：纯文本生成，无联网无思考，速度快但地址有时虚构
#   智谱 glm-4-plus     收费：质量介于上两者之间
#   DeepSeek deepseek-chat
#   Kimi moonshot-v1-8k
VITE_LLM_MODEL=glm-5.1

# 强制关闭联网搜索（默认 0=开启）。如果你的端点不支持 web_search 工具，
# 或想节省 Token，把它改成 1。
# VITE_LLM_DISABLE_WEB_SEARCH=0

# ============================================================
# 高德地图 Key（可选）
#
# 不填也能用 — 时间线主功能不受影响；
# 配上之后会激活：每天独立地图、节点定位、4 种交通方式路径规划。
#
# 申请步骤（5 分钟）：
#   1. 访问 https://console.amap.com/dev/key/app 注册 + 实名（个人免费）
#   2. 「应用管理」→「创建新应用」→「添加 Key」
#   3. 服务平台选「Web 端 (JS API)」
#   4. 把生成的 Key 填到下面 VITE_AMAP_KEY
#   5. 同时复制「安全密钥(jscode)」填到 VITE_AMAP_SECURITY_CODE
#
# ⚠️ 安全提示：
#   高德新版 JS API 要求把 securityJsCode 配到前端，本演示项目按此实现；
#   生产环境请通过自建代理转发以避免 Key 泄露。
#   开发期请把允许域名留空（默认 localhost 可用），上线时再绑定域名白名单。
# ============================================================
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
